  "components": [
    {
      "name": "Journal action",
      "kind": "button",
      "refersTo": "journal-action",
      "description": "Chapter-colored text action with a bottom rule.",
      "html": "<button class=\"ds-journal-action\">Explore what I’ve built</button>",
      "css": ".ds-journal-action{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:13px 0;margin-top:20px;border:0;border-bottom:1px solid var(--journal-red);background:none;color:var(--journal-red);font-family:\"DM Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:13px;font-weight:600;text-align:left;cursor:pointer}.ds-journal-action:hover{color:#6e241c}.ds-journal-action:focus-visible{outline:3px solid #9780f0;outline-offset:4px}.ds-journal-action:disabled{opacity:.35;cursor:not-allowed}"
    },
    {
      "name": "Chapter navigation",
      "kind": "nav",
      "refersTo": "chapter-tab",
      "description": "Pressed chapter receives a top rule and matching accent.",
      "html": "<nav class=\"ds-chapters\" aria-label=\"Explore Ethan’s story\"><button aria-pressed=\"true\">The builder</button><button aria-pressed=\"false\">The explorer</button><button aria-pressed=\"false\">The playful side</button></nav>",
      "css": ".ds-chapters{display:flex;gap:22px;border-top:1px solid var(--journal-rule)}.ds-chapters button{display:flex;align-items:center;min-height:44px;gap:12px;padding:17px 0 13px;margin-top:-1px;border:0;border-top:2px solid transparent;background:none;font-family:\"DM Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:12px;color:#546158;transition:color .2s;cursor:pointer}.ds-chapters button[aria-pressed=true]{border-color:var(--journal-red);color:var(--journal-red);font-weight:600}.ds-chapters button:focus-visible{outline:3px solid #9780f0;outline-offset:4px}@media(max-width:759px){.ds-chapters{gap:0;justify-content:space-between}.ds-chapters button{gap:5px;font-size:10px}}"
    },
    {
      "name": "App shelf copy",
      "kind": "card",
      "refersTo": "shelf-card",
      "description": "Cream product evidence card; preview artwork is intentionally omitted from this isolated sample.",
      "html": "<article class=\"ds-shelf-card\"><div class=\"ds-shelf-copy\"><small>Android + web</small><h2>JuxTravel</h2><p>Travel discovery, independent stays, and a personal travel Passport.</p><div><a href=\"https://play.google.com/store/apps/details?id=com.hostsphere.juxtravel\" target=\"_blank\" rel=\"noopener noreferrer\">Google Play</a></div></div></article>",
      "css": ".ds-shelf-card{min-width:0;background:var(--journal-paper);color:var(--journal-ink);border-radius:10px;overflow:hidden;font-family:\"DM Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-shelf-copy{padding:14px}.ds-shelf-copy small{font-size:9px;color:#5a655b}.ds-shelf-copy h2{font-size:17px;margin-top:5px;letter-spacing:-.02em}.ds-shelf-copy p{font-size:11px;line-height:1.6;margin:8px 0 15px;color:#49574e;min-height:53px}.ds-shelf-copy>div{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--journal-rule);padding-top:12px}.ds-shelf-copy a{font-size:11px;font-weight:600;text-decoration:none;color:var(--journal-red)}.ds-shelf-copy a:hover{text-decoration:underline}.ds-shelf-copy a:focus-visible{outline:3px solid #9780f0;outline-offset:4px}"
    },
    {
      "name": "Travel postcard",
      "kind": "button",
      "refersTo": "postcard",
      "description": "Square postcard button inside alternating ±1 degree entry wrappers; an expanded story appears directly below its card.",
      "html": "<div class=\"ds-place-entry\"><button class=\"ds-postcard\" aria-expanded=\"true\" aria-controls=\"ds-shimla-story\"><span><strong>Shimla</strong></span></button><div class=\"ds-inline-story\" id=\"ds-shimla-story\"><p>From Ethan’s travel journal.</p></div></div>",
      "css": " .ds-place-entry{min-width:0;transform:rotate(-1deg)}.ds-postcard{width:100%;display:flex;gap:14px;align-items:center;text-align:left;border:0;border-radius:0;background:#faf7e9;padding:30px 20px;min-height:120px;color:#456042;box-shadow:0 7px 15px #29412615;cursor:pointer}.ds-postcard>span{flex:1}.ds-postcard strong{display:block;font:500 25px Fraunces,Georgia,serif;color:#263c32}.ds-postcard[aria-expanded=true]{outline:2px solid #5f7858;outline-offset:4px}.ds-postcard:focus-visible{outline:3px solid #9780f0;outline-offset:4px}.ds-inline-story{background:#faf7e9;padding:0 20px 22px;font-family:\"DM Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-inline-story p{color:#425640;font-size:12px;line-height:1.7}"
    },
    {
      "name": "Technical tags",
      "kind": "chip",
